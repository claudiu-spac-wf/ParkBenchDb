  INITIAL ?
  LABEL "Event Date Time"
  POSITION 7
  MAX-WIDTH 12
  COLUMN-LABEL "Event Date Time"
  ORDER 60
  MANDATORY

ADD FIELD "TableName" OF "AuditLog" AS character
  DESCRIPTION "Name of the audited table (weighted toward Account, Customer, Card)"
  FORMAT "x(32)"
  INITIAL ""
  LABEL "Table Name"
  POSITION 8
  MAX-WIDTH 64
  COLUMN-LABEL "Table Name"
  ORDER 70
  MANDATORY

ADD FIELD "RecordId" OF "AuditLog" AS int64
  DESCRIPTION "<Table>Id of the audited row"
