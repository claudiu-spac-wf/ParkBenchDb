  FORMAT "99/99/9999 HH:MM:SS.SSS+HH:MM"
  INITIAL "now"
  LABEL "Created At"
  POSITION 6
  MAX-WIDTH 12
  COLUMN-LABEL "Created At"
  ORDER 50
  MANDATORY

ADD FIELD "EventDateTime" OF "AuditLog" AS datetime-tz
