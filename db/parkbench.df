  LABEL "Transfer Date Time"
  POSITION 10
  MAX-WIDTH 12
  COLUMN-LABEL "Transfer Date Time"
  ORDER 90
  MANDATORY

ADD FIELD "DebitTransactionId" OF "Transfer" AS int64
  DESCRIPTION "Reference to DebitTransaction"
  FORMAT ">>>>>>>>>>>9"
  INITIAL "0"
  LABEL "Debit Transaction Id"
  POSITION 11
  MAX-WIDTH 8
  COLUMN-LABEL "Debit Transaction Id"
  ORDER 100
  MANDATORY

ADD FIELD "CreditTransactionId" OF "Transfer" AS int64
