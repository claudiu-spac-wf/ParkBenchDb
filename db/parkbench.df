  FORMAT ">>>>>>>>>>>9"
  INITIAL "0"
  LABEL "Audit Log Id"
  POSITION 2
  MAX-WIDTH 8
  COLUMN-LABEL "Audit Log Id"
  ORDER 10
  MANDATORY

ADD FIELD "RandomInt10" OF "AuditLog" AS integer
  DESCRIPTION "Independent uniform random value 1–10 for selecting ≈ 10% subsets. 0 = unassigned (invalid)."
  FORMAT ">9"
  INITIAL "0"
  LABEL "Random Int 10"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Random Int 10"
  ORDER 20
  MANDATORY

ADD FIELD "RandomInt100" OF "AuditLog" AS integer
  DESCRIPTION "Independent uniform random value 1–100 for selecting ≈ 1% subsets. 0 = unassigned (invalid)."
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Random Int 100"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "Random Int 100"
  ORDER 30
  MANDATORY

