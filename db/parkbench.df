ADD TABLE "BenchmarkTableInfo"
  AREA "PB_Ref_Data"
  LABEL "Benchmark Table Info"
  DESCRIPTION "Row counts and max sequential IDs per table"
  DUMP-NAME "benchmarktableinfo"

ADD FIELD "BenchmarkTableInfoId" OF "BenchmarkTableInfo" AS int64
  DESCRIPTION "Dense sequential identifier, 1..N with no gaps after the initial load. Runtime inserts use NEXT-VALUE(SeqBenchmarkTableInfoId)."
  FORMAT ">>>>>>>>>>>9"
  INITIAL "0"
  LABEL "Benchmark Table Info Id"
  POSITION 2
  MAX-WIDTH 8
  COLUMN-LABEL "Benchmark Table Info Id"
  ORDER 10
  MANDATORY

ADD FIELD "RandomInt10" OF "BenchmarkTableInfo" AS integer
  DESCRIPTION "Independent uniform random value 1–10 for selecting ≈ 10% subsets. 0 = unassigned (invalid)."
  FORMAT ">9"
  INITIAL "0"
  LABEL "Random Int 10"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Random Int 10"
  ORDER 20
  MANDATORY

ADD FIELD "RandomInt100" OF "BenchmarkTableInfo" AS integer
  DESCRIPTION "Independent uniform random value 1–100 for selecting ≈ 1% subsets. 0 = unassigned (invalid)."
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Random Int 100"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "Random Int 100"
  ORDER 30
  MANDATORY

ADD FIELD "RandomInt1000" OF "BenchmarkTableInfo" AS integer
  DESCRIPTION "Independent uniform random value 1–1000 for selecting ≈ 0.1% subsets. 0 = unassigned (invalid)."
  FORMAT ">>>9"
  INITIAL "0"
  LABEL "Random Int 1000"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "Random Int 1000"
  ORDER 40
  MANDATORY

ADD FIELD "CreatedAt" OF "BenchmarkTableInfo" AS datetime-tz
  DESCRIPTION "When the row was created. For historical rows, a synthetic timestamp consistent with the row's business date."
  FORMAT "99/99/9999 HH:MM:SS.SSS+HH:MM"
  INITIAL "now"
  LABEL "Created At"
  POSITION 6
  MAX-WIDTH 12
  COLUMN-LABEL "Created At"
  ORDER 50
  MANDATORY

ADD FIELD "TableName" OF "BenchmarkTableInfo" AS character
  DESCRIPTION "Exact table name"
  FORMAT "x(32)"
  INITIAL ""
  LABEL "Table Name"
  POSITION 7
  MAX-WIDTH 64
  COLUMN-LABEL "Table Name"
  ORDER 60
  MANDATORY

ADD FIELD "TableRowCount" OF "BenchmarkTableInfo" AS int64
  DESCRIPTION "Rows after the load (named to avoid the reserved/function word ROWCOUNT)"
  FORMAT ">>>>>>>>>>>9"
  INITIAL "0"
  LABEL "Table Row Count"
  POSITION 8
  MAX-WIDTH 8
  COLUMN-LABEL "Table Row Count"
  ORDER 70
  MANDATORY

ADD FIELD "MaxId" OF "BenchmarkTableInfo" AS int64
  DESCRIPTION "Highest <Table>Id; equals TableRowCount right after the load"
  FORMAT ">>>>>>>>>>>9"
  INITIAL "0"
  LABEL "Max Id"
  POSITION 9
  MAX-WIDTH 8
  COLUMN-LABEL "Max Id"
  ORDER 80
  MANDATORY

ADD FIELD "ScaleFactor" OF "BenchmarkTableInfo" AS decimal
  DESCRIPTION "Scale factor used for the load"
  FORMAT ">>9.99"
  INITIAL "1"
  LABEL "Scale Factor"
  POSITION 10
  MAX-WIDTH 17
  COLUMN-LABEL "Scale Factor"
  DECIMALS 2
  ORDER 90
  MANDATORY

ADD FIELD "VolumeTier" OF "BenchmarkTableInfo" AS character
  DESCRIPTION "Tier at scale factor 1"
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Volume Tier"
  POSITION 11
  MAX-WIDTH 20
  COLUMN-LABEL "Volume Tier"
  ORDER 100
  MANDATORY

ADD FIELD "RecordSizeTier" OF "BenchmarkTableInfo" AS character
  DESCRIPTION "Record-size tier of the table"
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Record Size Tier"
  POSITION 12
  MAX-WIDTH 20
  COLUMN-LABEL "Record Size Tier"
  ORDER 110
  MANDATORY

ADD FIELD "AsOfDate" OF "BenchmarkTableInfo" AS date
  DESCRIPTION "End of the history window"
  FORMAT "99/99/9999"
  INITIAL ?
  LABEL "As Of Date"
  POSITION 13
  MAX-WIDTH 4
  COLUMN-LABEL "As Of Date"
  ORDER 120
  MANDATORY

ADD FIELD "LoadedAt" OF "BenchmarkTableInfo" AS datetime-tz
  DESCRIPTION "When the load finished"
  FORMAT "99/99/9999 HH:MM:SS.SSS+HH:MM"
  INITIAL ?
  LABEL "Loaded At"
  POSITION 14
  MAX-WIDTH 12
  COLUMN-LABEL "Loaded At"
  ORDER 130
  MANDATORY

