  FORMAT ">>>9"
  INITIAL "0"
  LABEL "Random Int 1000"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "Random Int 1000"
  ORDER 40
  MANDATORY

ADD FIELD "CreatedAt" OF "LoanPayment" AS datetime-tz
  DESCRIPTION "When the row was created. For historical rows, a synthetic timestamp consistent with the row's business date."
  FORMAT "99/99/9999 HH:MM:SS.SSS+HH:MM"
  INITIAL "now"
  LABEL "Created At"
  POSITION 6
  MAX-WIDTH 12
  COLUMN-LABEL "Created At"
  ORDER 50
  MANDATORY

ADD FIELD "LoanId" OF "LoanPayment" AS int64
