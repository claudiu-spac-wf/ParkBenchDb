  INITIAL "0"
  LABEL "Late Fee"
  POSITION 13
  MAX-WIDTH 17
  COLUMN-LABEL "Late Fee"
  DECIMALS 2
  ORDER 120
  MANDATORY

ADD FIELD "DebitTransactionId" OF "LoanPayment" AS int64
  DESCRIPTION "Reference to DebitTransaction"
  FORMAT ">>>>>>>>>>>9"
  INITIAL "0"
  LABEL "Debit Transaction Id"
  POSITION 14
  MAX-WIDTH 8
  COLUMN-LABEL "Debit Transaction Id"
  ORDER 130
  MANDATORY

