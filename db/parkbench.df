  DESCRIPTION "Independent uniform random value 1–1000 for selecting ≈ 0.1% subsets. 0 = unassigned (invalid)."
  FORMAT ">>>9"
  INITIAL "0"
  LABEL "Random Int 1000"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "Random Int 1000"
  ORDER 40
