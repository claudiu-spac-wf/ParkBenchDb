ADD TABLE "AccountType"
  AREA "PB_Ref_Data"
  LABEL "Account Type"
  DESCRIPTION "Product definitions (checking, savings, CD…)"
  DUMP-NAME "accounttype"

ADD FIELD "AccountTypeId" OF "AccountType" AS int64
  DESCRIPTION "Dense sequential identifier, 1..N with no gaps after the initial load. Runtime inserts use NEXT-VALUE(SeqAccountTypeId)."
  FORMAT ">>>>>>>>>>>9"
  INITIAL "0"
  LABEL "Account Type Id"
  POSITION 2
  MAX-WIDTH 8
  COLUMN-LABEL "Account Type Id"
  ORDER 10
  MANDATORY

ADD FIELD "RandomInt10" OF "AccountType" AS integer
  DESCRIPTION "Independent uniform random value 1–10 for selecting ≈ 10% subsets. 0 = unassigned (invalid)."
  FORMAT ">9"
  INITIAL "0"
  LABEL "Random Int 10"
  POSITION 3
  MAX-WIDTH 4
  COLUMN-LABEL "Random Int 10"
  ORDER 20
  MANDATORY

ADD FIELD "RandomInt100" OF "AccountType" AS integer
  DESCRIPTION "Independent uniform random value 1–100 for selecting ≈ 1% subsets. 0 = unassigned (invalid)."
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Random Int 100"
  POSITION 4
  MAX-WIDTH 4
  COLUMN-LABEL "Random Int 100"
  ORDER 30
  MANDATORY

ADD FIELD "RandomInt1000" OF "AccountType" AS integer
  DESCRIPTION "Independent uniform random value 1–1000 for selecting ≈ 0.1% subsets. 0 = unassigned (invalid)."
  FORMAT ">>>9"
  INITIAL "0"
  LABEL "Random Int 1000"
  POSITION 5
  MAX-WIDTH 4
  COLUMN-LABEL "Random Int 1000"
  ORDER 40
  MANDATORY

ADD FIELD "CreatedAt" OF "AccountType" AS datetime-tz
  DESCRIPTION "When the row was created. For historical rows, a synthetic timestamp consistent with the row's business date."
  FORMAT "99/99/9999 HH:MM:SS.SSS+HH:MM"
  INITIAL "now"
  LABEL "Created At"
  POSITION 6
  MAX-WIDTH 12
  COLUMN-LABEL "Created At"
  ORDER 50
  MANDATORY

ADD FIELD "AccountTypeCode" OF "AccountType" AS character
  DESCRIPTION "e.g. CHKBASIC, SAVHIYLD, CD12M"
  FORMAT "x(10)"
  INITIAL ""
  LABEL "Account Type Code"
  POSITION 7
  MAX-WIDTH 20
  COLUMN-LABEL "Account Type Code"
  ORDER 60
  MANDATORY

ADD FIELD "AccountTypeName" OF "AccountType" AS character
  DESCRIPTION "Product name"
  FORMAT "x(50)"
  INITIAL ""
  LABEL "Account Type Name"
  POSITION 8
  MAX-WIDTH 100
  COLUMN-LABEL "Account Type Name"
  ORDER 70
  MANDATORY

ADD FIELD "Category" OF "AccountType" AS character
  DESCRIPTION "CHECKING, SAVINGS, MONEYMARKET, CD"
  FORMAT "x(12)"
  INITIAL ""
  LABEL "Category"
  POSITION 9
  MAX-WIDTH 24
  COLUMN-LABEL "Category"
  ORDER 80
  MANDATORY

ADD FIELD "Description" OF "AccountType" AS character
  DESCRIPTION "Human-readable description"
  FORMAT "x(200)"
  INITIAL ""
  LABEL "Description"
  POSITION 10
  MAX-WIDTH 400
  COLUMN-LABEL "Description"
  ORDER 90
  MANDATORY

ADD FIELD "TermsText" OF "AccountType" AS character
  DESCRIPTION "Plain-text terms, 900–1,200 characters (makes the record Wide without a LOB)"
  FORMAT "x(1200)"
  INITIAL ""
  LABEL "Terms Text"
  POSITION 11
  MAX-WIDTH 2400
  COLUMN-LABEL "Terms Text"
  ORDER 100
  MANDATORY

ADD FIELD "MinimumBalance" OF "AccountType" AS decimal
  DESCRIPTION "Minimum balance"
  FORMAT "->>>,>>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Minimum Balance"
  POSITION 12
  MAX-WIDTH 17
  COLUMN-LABEL "Minimum Balance"
  DECIMALS 2
  ORDER 110
  MANDATORY

ADD FIELD "MonthlyFee" OF "AccountType" AS decimal
  DESCRIPTION "Monthly maintenance fee"
  FORMAT "->>>,>>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Monthly Fee"
  POSITION 13
  MAX-WIDTH 17
  COLUMN-LABEL "Monthly Fee"
  DECIMALS 2
  ORDER 120
  MANDATORY

ADD FIELD "OverdraftAllowed" OF "AccountType" AS logical
  DESCRIPTION "Whether overdraft is allowed"
  FORMAT "yes/no"
  INITIAL "no"
  LABEL "Overdraft Allowed"
  POSITION 14
  MAX-WIDTH 1
  COLUMN-LABEL "Overdraft Allowed"
  ORDER 130
  MANDATORY

ADD FIELD "TermMonths" OF "AccountType" AS integer
  DESCRIPTION "Term in months"
  FORMAT ">>9"
  INITIAL "0"
  LABEL "Term Months"
  POSITION 15
  MAX-WIDTH 4
  COLUMN-LABEL "Term Months"
  ORDER 140
  MANDATORY

ADD FIELD "CurrentInterestRate" OF "AccountType" AS decimal
  DESCRIPTION "Equals the latest InterestRateHistory row"
  FORMAT ">>9.9999"
  INITIAL "0"
  LABEL "Current Interest Rate"
  POSITION 16
  MAX-WIDTH 17
  COLUMN-LABEL "Current Interest Rate"
  DECIMALS 4
  ORDER 150
  MANDATORY

ADD FIELD "IsActive" OF "AccountType" AS logical
  DESCRIPTION "Whether the row is active"
  FORMAT "yes/no"
  INITIAL "yes"
  LABEL "Is Active"
  POSITION 17
  MAX-WIDTH 1
  COLUMN-LABEL "Is Active"
  ORDER 160
  MANDATORY

ADD INDEX "PkAccountType" ON "AccountType"
  AREA "PB_Ref_Idx"
  UNIQUE
  PRIMARY
  INDEX-FIELD "AccountTypeId" ASCENDING

ADD INDEX "IxRandomInt10" ON "AccountType"
  AREA "PB_Ref_Idx"
  INDEX-FIELD "RandomInt10" ASCENDING
  INDEX-FIELD "AccountTypeId" ASCENDING

ADD INDEX "IxRandomInt100" ON "AccountType"
  AREA "PB_Ref_Idx"
  INDEX-FIELD "RandomInt100" ASCENDING
  INDEX-FIELD "AccountTypeId" ASCENDING

ADD INDEX "IxRandomInt1000" ON "AccountType"
  AREA "PB_Ref_Idx"
  INDEX-FIELD "RandomInt1000" ASCENDING
  INDEX-FIELD "AccountTypeId" ASCENDING

ADD INDEX "UxAccountTypeCode" ON "AccountType"
  AREA "PB_Ref_Idx"
  UNIQUE
  INDEX-FIELD "AccountTypeCode" ASCENDING

ADD INDEX "IxCategory" ON "AccountType"
  AREA "PB_Ref_Idx"
  INDEX-FIELD "Category" ASCENDING

